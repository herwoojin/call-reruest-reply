rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // 커스텀 클레임 role (Admin SDK setUserRole로 부여)
    function role() { return request.auth.token.role; }
    function signedIn() { return request.auth != null; }
    function isAdmin() { return signedIn() && role() == 'ADMIN'; }

    // 본인 프로필: 읽기 본인+ADMIN, role 필드는 클라이언트 수정 금지
    match /profiles/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || isAdmin());
      allow update: if signedIn() && request.auth.uid == uid
        && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role']);
      allow create, delete: if isAdmin();
    }

    // 이하 컬렉션(stores, facility_requests, quotes, chat_messages ...)은
    // Phase 1에서 FLOW 열람 원칙(ERD §3)대로 확장한다. 기본은 전부 차단.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
