# ── Firebase 웹 앱 (콘솔 → 프로젝트 설정 → 일반 → 웹 앱 SDK 구성)
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# ── Firebase Admin (콘솔 → 서비스 계정 → 새 비공개 키 → base64 인코딩)
#    macOS: base64 -i serviceAccountKey.json | tr -d '\n'
FIREBASE_SERVICE_ACCOUNT_JSON=

# ── AI
ANTHROPIC_API_KEY=

# ── 구글시트 견적/단가 (T0-3: Firebase와 같은 GCP 프로젝트의 서비스 계정 재사용 가능)
GOOGLE_SERVICE_ACCOUNT_JSON=         # 서비스 계정 키 JSON의 base64
SHEET_TPL_QUOTE_ID=                   # TPL_견적서 파일 ID (URL의 /d/{ID}/)
SHEET_TPL_PRICE_ID=                   # TPL_단가표 파일 ID
SHEET_STORES_ID=                      # 점포 마스터 시트(18,000 점포·매칭) 파일 ID ⭐
SHEET_TPL_WORK_ID=                    # 작업 현황 시트 템플릿 파일 ID ⭐

# ── Web Push (npx web-push generate-vapid-keys)
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
